{
  "_source": "Production website_builder.review_blocks, read 2026-10-18 with the read-only role. Inline SVG bodies removed; everything else verbatim. v2 shapes are shared by Harbor, Lumen, Atlas, Meridian and Solstice.",
  "shapes": {
    "v1-grid": "<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4\">\n{{start_review_loop}}\n  <div class=\"bg-white rounded-xl shadow-md p-6 flex flex-col gap-3\">\n    <div class=\"flex items-center gap-3\">\n      <img src=\"{{review.reviewer_photo}}\" alt=\"{{review.reviewer_name}}\" class=\"w-12 h-12 rounded-full object-cover bg-gray-200\" onerror=\"this.style.display='none'\" />\n      <div>\n        <p class=\"font-semibold text-gray-900 text-sm\">{{review.reviewer_name}}</p>\n        <p class=\"text-gray-400 text-xs\">{{review.date}}</p>\n      </div>\n    </div>\n    <div class=\"flex\">{{review.stars_html}}</div>\n    <p class=\"text-gray-600 text-sm leading-relaxed\">{{review.text}}</p>\n  </div>\n{{end_review_loop}}\n</div>",
    "v1-carousel": "<style>\n  [data-review-card] { width: 100%; }\n  @media (min-width: 768px) { [data-review-card] { width: 33.3333%; } }\n</style>\n\n<div class=\"relative\" data-review-carousel>\n  <div class=\"relative overflow-hidden\">\n    <div class=\"flex transition-transform duration-500 ease-out\" data-review-slider style=\"transform: translateX(0%);\">\n{{start_review_loop}}\n      <div data-review-card class=\"flex-shrink-0 px-2 md:px-4\">\n        <div class=\"bg-white p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 relative flex flex-col\" style=\"min-height:280px;\">\n          <div class=\"absolute top-6 right-6 md:top-8 md:right-8\">\n            <svg></svg>\n          </div>\n          <div class=\"flex items-center gap-4 mb-5\">\n            <div class=\"w-12 h-12 rounded-full text-white flex items-center justify-center font-bold text-lg font-serif overflow-hidden flex-shrink-0\" style=\"background: linear-gradient(135deg, #3b82f6, #9333ea);\">\n              <img src=\"{{review.reviewer_photo}}\" alt=\"{{review.reviewer_name}}\" class=\"w-full h-full object-cover\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='block'\" />\n              <span style=\"display:none\">{{review.reviewer_name}}</span>\n            </div>\n            <div>\n              <h4 class=\"font-bold text-base text-gray-900 font-sans\">{{review.reviewer_name}}</h4>\n              <p class=\"text-xs text-gray-400 font-sans\">{{review.date}}</p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-2 mb-4\">\n            <div class=\"flex text-yellow-400 text-sm\">{{review.stars_html}}</div>\n            <span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium ml-auto\" style=\"background:rgba(22,163,74,0.08);color:#16a34a;\">\n              <svg></svg>\n              Google Verified\n            </span>\n          </div>\n          <div class=\"flex-grow relative\">\n            <div data-review-text class=\"overflow-hidden transition-all duration-300\" style=\"max-height:96px;\">\n              <p class=\"text-gray-600 text-sm md:text-base leading-relaxed font-sans\">\"{{review.text}}\"</p>\n            </div>\n            <div data-review-fade class=\"absolute bottom-0 left-0 right-0 h-8 pointer-events-none\" style=\"background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,1));\"></div>\n          </div>\n          <button data-review-toggle class=\"mt-3 text-xs font-medium font-sans text-left transition-colors\" style=\"color:#232323;\">Read more</button>\n        </div>\n      </div>\n{{end_review_loop}}\n    </div>\n  </div>\n  <div class=\"flex justify-center gap-3 mt-8\">\n    <button data-review-prev class=\"w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 transition-colors\" aria-label=\"Previous reviews\">\n      <svg></svg>\n    </button>\n    <button data-review-next class=\"w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 transition-colors\" aria-label=\"Next reviews\">\n      <svg></svg>\n    </button>\n  </div>\n</div>\n\n<script>\n(function(){\n  function initCarousel() {\n    document.querySelectorAll('[data-review-carousel]').forEach(function(carousel){\n      var slider = carousel.querySelector('[data-review-slider]');\n      var cards = carousel.querySelectorAll('[data-review-card]');\n      var prevBtn = carousel.querySelector('[data-review-prev]');\n      var nextBtn = carousel.querySelector('[data-review-next]');\n      if(!slider||!cards.length||!prevBtn||!nextBtn) return;\n      var perPage = window.innerWidth < 768 ? 1 : 3;\n      var current = 0;\n      var maxIndex = Math.max(0, cards.length - perPage);\n      function update(){\n        slider.style.transform = 'translateX(-' + (current * (100/perPage)) + '%)';\n      }\n      prevBtn.addEventListener('click', function(){ if(current>0){current--;update();} });\n      nextBtn.addEventListener('click', function(){ if(current<maxIndex){current++;update();} });\n      window.addEventListener('resize', function(){\n        perPage = window.innerWidth < 768 ? 1 : 3;\n        maxIndex = Math.max(0, cards.length - perPage);\n        if(current>maxIndex) current=maxIndex;\n        update();\n      });\n    });\n  }\n\n  function initReadMore() {\n    document.querySelectorAll('[data-review-toggle]').forEach(function(btn){\n      var wrapper = btn.closest('[data-review-card]');\n      if(!wrapper) return;\n      var textBox = wrapper.querySelector('[data-review-text]');\n      var fade = wrapper.querySelector('[data-review-fade]');\n      if(!textBox) return;\n      var p = textBox.querySelector('p');\n      if(!p) return;\n\n      textBox.style.maxHeight = 'none';\n      var naturalHeight = p.offsetHeight;\n      var LIMIT = 96;\n      textBox.style.maxHeight = LIMIT + 'px';\n      var collapsed = true;\n\n      if(naturalHeight <= LIMIT){\n        btn.style.display = 'none';\n        if(fade) fade.style.display = 'none';\n        textBox.style.maxHeight = 'none';\n        return;\n      }\n\n      btn.style.display = 'block';\n      btn.addEventListener('click', function(){\n        collapsed = !collapsed;\n        if(collapsed){\n          textBox.style.maxHeight = LIMIT + 'px';\n          btn.textContent = 'Read more';\n          if(fade) fade.style.display = 'block';\n        } else {\n          textBox.style.maxHeight = naturalHeight + 'px';\n          btn.textContent = 'Read less';\n          if(fade) fade.style.display = 'none';\n        }\n      });\n    });\n  }\n\n  if(document.readyState === 'complete') {\n    initCarousel();\n    initReadMore();\n  } else {\n    window.addEventListener('load', function(){\n      initCarousel();\n      initReadMore();\n    });\n  }\n})();\n</script>",
    "v1-list-compact": "<div class=\"flex flex-col divide-y divide-gray-100\">\n{{start_review_loop}}\n  <div class=\"py-4 flex flex-col gap-2\">\n    <div class=\"flex items-start justify-between gap-3\">\n      <div class=\"flex items-center gap-3 min-w-0\">\n        <div class=\"w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white flex-shrink-0 overflow-hidden\" style=\"background:linear-gradient(135deg,#3b82f6,#9333ea);\">\n          <img src=\"{{review.reviewer_photo}}\" alt=\"{{review.reviewer_name}}\" class=\"w-full h-full object-cover\" onerror=\"this.style.display='none';this.nextElementSibling.style.display='flex'\" />\n          <span style=\"display:none;\">{{review.reviewer_name}}</span>\n        </div>\n        <div class=\"min-w-0\">\n          <div class=\"flex items-center gap-2 flex-wrap\">\n            <span class=\"font-semibold text-sm text-gray-900 font-sans\">{{review.reviewer_name}}</span>\n            <span class=\"inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[10px] font-medium\" style=\"background:rgba(22,163,74,0.08);color:#16a34a;\">\n              <svg></svg>\n              Verified\n            </span>\n          </div>\n          <div class=\"flex items-center gap-2 mt-0.5\">\n            <div class=\"flex text-yellow-400 text-xs\">{{review.stars_html}}</div>\n            <span class=\"text-gray-400 text-[10px] font-sans\">{{review.date}}</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex-shrink-0\">\n        <svg></svg>\n      </div>\n    </div>\n    <p class=\"text-gray-600 text-xs leading-relaxed font-sans pl-12\">{{review.text}}</p>\n  </div>\n{{end_review_loop}}\n</div>",
    "v2-carousel": "<div class=\"carousel\" data-carousel data-per-view-md=\"2\" data-per-view-lg=\"3\" data-loop>\n  <div class=\"carousel-viewport\">\n    <div class=\"carousel-track\" data-carousel-track>\n      {{start_review_loop}}\n      <div class=\"carousel-slide\"><div class=\"card review-card\">\n        <div class=\"flex items-center justify-between gap-3\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"{{review.stars}} out of 5 stars\">{{review.stars_html}}</div>\n          <span class=\"badge\"><svg></svg>Google review</span>\n        </div>\n        <p class=\"review-text line-clamp-6\">{{review.text}}</p>\n        <div class=\"review-meta mt-auto\">\n          <img src=\"{{review.reviewer_photo}}\" alt=\"{{review.reviewer_name}}\" loading=\"lazy\" onerror=\"this.style.display='none'\" />\n          <div class=\"min-w-0\">\n            <p class=\"font-semibold truncate\">{{review.reviewer_name}}</p>\n            <p class=\"muted\">{{review.date}}</p>\n          </div>\n        </div>\n      </div></div>\n      {{end_review_loop}}\n    </div>\n  </div>\n  <div class=\"carousel-nav\">\n    <button type=\"button\" class=\"carousel-btn\" data-carousel-prev aria-label=\"Previous reviews\"><svg></svg></button>\n    <div class=\"carousel-dots\" data-carousel-dots></div>\n    <button type=\"button\" class=\"carousel-btn\" data-carousel-next aria-label=\"Next reviews\"><svg></svg></button>\n  </div>\n</div>",
    "v2-grid": "<div class=\"grid gap-6 md:grid-cols-2 lg:grid-cols-3\">\n  {{start_review_loop}}\n  <div class=\"card review-card\">\n        <div class=\"flex items-center justify-between gap-3\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"{{review.stars}} out of 5 stars\">{{review.stars_html}}</div>\n          <span class=\"badge\"><svg></svg>Google review</span>\n        </div>\n        <p class=\"review-text\">{{review.text}}</p>\n        <div class=\"review-meta mt-auto\">\n          <img src=\"{{review.reviewer_photo}}\" alt=\"{{review.reviewer_name}}\" loading=\"lazy\" onerror=\"this.style.display='none'\" />\n          <div class=\"min-w-0\">\n            <p class=\"font-semibold truncate\">{{review.reviewer_name}}</p>\n            <p class=\"muted\">{{review.date}}</p>\n          </div>\n        </div>\n      </div>\n  {{end_review_loop}}\n</div>"
  }
}