# Edge-block runtime config.
# Copy to /opt/alloro/edge-block/.env on alloro-renderer, fill real values, chmod 600.
# NEVER commit the real .env — the webhook URL is a secret capability URL.

# n8n webhook that fans the alert out to Mailgun.
# NOTE: the payload MUST include cc:[] and bcc:[] (the shared Mailgun node calls .join on them),
# and `body` is sent as the HTML part — analyze-dryrun.sh wraps it in <pre> already.
ALLORO_EMAIL_SERVICE_WEBHOOK=https://n8n.getalloro.com/webhook/<id>

# Comma-separated recipients for the daily watchdog email (the Gmail we can verify is dave@).
ALERT_EMAIL=dave@getalloro.com
